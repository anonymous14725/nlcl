extends Node3D
## NLCL game runtime for Godot 4: builds entities in code, default controls,
## spawning, and cross-module channels through the NLCL HTTP hub.
## main.gd extends this script and implements _build().  Generated by NLCL.

var entities := {}     # identifier -> entity node
var recipes := {}      # identifier -> creation parameters (for spawning)
var remote := {}       # "src.field" -> latest value received over a channel
var channels := []
var _last_bool := {}
var _keys_prev := {}
var _spawned := 0
var _colors := {}


func _ready() -> void:
	var light := DirectionalLight3D.new()
	light.rotation_degrees = Vector3(-50, 30, 0)
	add_child(light)
	var env := WorldEnvironment.new()
	env.environment = Environment.new()
	env.environment.background_mode = Environment.BG_COLOR
	env.environment.background_color = Color(0.09, 0.1, 0.13)
	env.environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.environment.ambient_light_color = Color(0.6, 0.6, 0.6)
	add_child(env)
	_build()


func _build() -> void:
	pass  # overridden in main.gd


# ------------------------------------------------------------------ building
func make(script: Script, id: String, kind: String, shape: String, pos: Vector3, size: Vector3,
		color: String, parent_id: String, flags: Dictionary) -> Node3D:
	recipes[id] = [script, kind, shape, size, color, flags]
	var n = script.new()
	n.name = id
	n.nlcl_world = self
	n.nlcl_id = id
	n.nlcl_kind = kind
	n.nlcl_controls = flags.get("controls", false)
	n.nlcl_auto_move = flags.get("auto_move", false)
	n.position = pos
	if n is RigidBody3D:
		n.can_sleep = false
		n.lock_rotation = true
		n.axis_lock_linear_z = true
	if shape != "none":
		var mi := MeshInstance3D.new()
		mi.mesh = _mesh(shape, size)
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color.from_string(color, Color.WHITE)
		mi.material_override = mat
		mi.name = "Mesh"
		n.add_child(mi)
		if n is CollisionObject3D:
			var cs := CollisionShape3D.new()
			cs.shape = _shape(shape, size)
			n.add_child(cs)
		# hit-box used for the "collision" trigger (overlap with any other entity)
		var area := Area3D.new()
		area.name = "HitBox"
		var acs := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = size * 1.05
		acs.shape = box
		area.add_child(acs)
		n.add_child(area)
		area.area_entered.connect(func(a): _hit(n, a))
	var parent = entities.get(parent_id) if parent_id != "" else null
	if parent != null and is_instance_valid(parent):
		parent.add_child(n)
	else:
		add_child(n)
	entities[id] = n
	return n


func add_template(script: Script, id: String, kind: String, shape: String, size: Vector3, color: String,
		flags: Dictionary) -> void:
	## an entity that only exists as a spawn template (e.g. a bullet fired by a spawner)
	recipes[id] = [script, kind, shape, size, color, flags]


func _mesh(shape: String, s: Vector3) -> Mesh:
	match shape:
		"sphere":
			var m := SphereMesh.new()
			m.radius = max(s.x, s.y) / 2.0
			m.height = max(s.x, s.y)
			return m
		"capsule":
			var m := CapsuleMesh.new()
			m.radius = s.x / 2.0
			m.height = max(s.y, s.x)
			return m
		"cylinder":
			var m := CylinderMesh.new()
			m.top_radius = s.x / 2.0
			m.bottom_radius = s.x / 2.0
			m.height = s.y
			return m
	var b := BoxMesh.new()
	b.size = s
	return b


func _shape(shape: String, s: Vector3) -> Shape3D:
	match shape:
		"sphere":
			var sp := SphereShape3D.new()
			sp.radius = max(s.x, s.y) / 2.0
			return sp
		"capsule":
			var c := CapsuleShape3D.new()
			c.radius = s.x / 2.0
			c.height = max(s.y, s.x)
			return c
	var b := BoxShape3D.new()
	b.size = s
	return b


func add_ground(pos: Vector3, size: Vector3) -> void:
	## static floor that is not an entity (no behaviours, no collision trigger)
	var g := StaticBody3D.new()
	g.name = "Ground"
	g.position = pos
	var mi := MeshInstance3D.new()
	var b := BoxMesh.new()
	b.size = size
	mi.mesh = b
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.25, 0.27, 0.33)
	mi.material_override = mat
	g.add_child(mi)
	var cs := CollisionShape3D.new()
	var bs := BoxShape3D.new()
	bs.size = size
	cs.shape = bs
	g.add_child(cs)
	add_child(g)


func to_bool(v) -> bool:
	if v is String:
		return v.to_lower() in ["true", "1", "on", "yes"]
	if v is bool or v is int or v is float:
		return bool(v)
	return v != null


func add_camera(pos: Vector3, follow: String) -> Camera3D:
	var cam := Camera3D.new()
	cam.position = pos
	cam.current = true
	cam.set_meta("follow", follow)
	add_child(cam)
	return cam


func _hit(n, area) -> void:
	var other = area.get_parent()
	if other == n or not is_instance_valid(n) or n.is_queued_for_deletion():
		return
	if other.get_parent() == n or n.get_parent() == other:   # parent <-> child
		return
	for e in [n, other]:
		if e.has_method("nlcl_get") and e.nlcl_get("collision") is bool and not e.nlcl_get("collision"):
			return
	if n.has_method("nlcl_collision"):
		n.nlcl_collision(other)


# ------------------------------------------------------------------ helpers used by entity scripts
func log_line(id: String, text: String) -> void:
	print("[%s] %s" % [id, text])


func get_prop(id: String, field: String, default_value = 0):
	var e = entities.get(id)
	if e == null or not is_instance_valid(e):
		return default_value
	var v = e.nlcl_get(field)
	return default_value if v == null else v


func get_pos(id: String) -> Vector3:
	var e = entities.get(id)
	if e == null or not is_instance_valid(e):
		return Vector3.ZERO
	return e.global_position


func get_remote(src: String, field: String, default_value = 0):
	return remote.get(src + "." + field, default_value)


func destroy(n) -> void:
	if entities.get(n.nlcl_id) == n:
		entities.erase(n.nlcl_id)
	n.queue_free()


func jump(n) -> void:
	var force = n.nlcl_get("jump_force")
	if force == null:
		force = 7.0
	if n is RigidBody3D:
		if abs(n.linear_velocity.y) < 0.05:
			n.linear_velocity.y = force
	else:
		n.position.y += 1.0


var _spawn_warned := {}


func spawn(template: String, at: Vector3) -> Node3D:
	var r = recipes.get(template)
	if r == null:
		if not _spawn_warned.has(template):
			_spawn_warned[template] = true
			log_line("nlcl", "cannot spawn '%s': unknown entity (set the 'spawn' property)" % template)
		return null
	var live := 0
	for k in entities:
		if is_instance_valid(entities[k]):
			live += 1
	if live >= 400:  # runaway spawning guard
		return null
	_spawned += 1
	var flags: Dictionary = r[5].duplicate()
	flags["controls"] = false
	return make(r[0], "%s_%d" % [template, _spawned], r[1], r[2], at, r[3], r[4], "", flags)


func reset_entity(n) -> void:
	n.position = n.nlcl_start
	if n is RigidBody3D:
		n.linear_velocity = Vector3.ZERO


func key_name(event: InputEventKey) -> String:
	## canonical key names shared with the HTML preview: space, enter, up, a, 1 ...
	return OS.get_keycode_string(event.keycode).to_lower()


func entity_at(screen_pos: Vector2) -> String:
	## identifier of the entity drawn under the mouse (nearest within 40 px)
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return ""
	var best := ""
	var best_d := 40.0
	for id in entities:
		var e = entities[id]
		if not is_instance_valid(e) or cam.is_position_behind(e.global_position):
			continue
		var d = cam.unproject_position(e.global_position).distance_to(screen_pos)
		if d < best_d:
			best_d = d
			best = id
	return best


func _key(code: int) -> bool:
	return Input.is_physical_key_pressed(code) or Input.is_key_pressed(code)


func _pressed_now(code: int) -> bool:
	var now := _key(code)
	var was: bool = _keys_prev.get(code, false)
	_keys_prev[code] = now
	return now and not was


# ------------------------------------------------------------------ per-frame built-ins
func _physics_process(delta: float) -> void:
	# evaluate every key (no short-circuit) so each one's previous state stays current
	var j_space := _pressed_now(KEY_SPACE)
	var j_up := _pressed_now(KEY_UP)
	var j_w := _pressed_now(KEY_W)
	var jump_pressed := j_space or j_up or j_w
	for id in entities.keys():
		var n = entities[id]
		if not is_instance_valid(n):
			entities.erase(id)
			continue
		var speed = n.nlcl_get("speed")
		speed = 5.0 if speed == null else float(speed)
		if n.nlcl_controls:
			var h := float(_key(KEY_RIGHT) or _key(KEY_D)) - float(_key(KEY_LEFT) or _key(KEY_A))
			var v := float(_key(KEY_UP) or _key(KEY_W)) - float(_key(KEY_DOWN) or _key(KEY_S))
			if n is RigidBody3D:
				n.linear_velocity.x = h * speed
				if jump_pressed:
					jump(n)
			else:
				n.position += Vector3(h, v, 0) * speed * delta
		if n.nlcl_auto_move:
			var dir := Vector3.RIGHT
			var d = n.nlcl_get("direction")
			if d is Array and d.size() >= 2:
				dir = Vector3(float(d[0]), float(d[1]), float(d[2]) if d.size() > 2 else 0.0).normalized()
			n.position += dir * speed * delta
			if n.position.length() > 500.0:
				destroy(n)
				continue
		var target = n.nlcl_get("target")
		if target is String and target != "" and entities.has(target) and is_instance_valid(entities[target]):
			n.position = n.position.move_toward(entities[target].position, speed * delta)
		# visuals follow the "color" / "visible" properties
		var vis = n.nlcl_get("visible")
		if vis != null:
			n.visible = to_bool(vis)
		var col = n.nlcl_get("color")
		if col is String and col != "" and _colors.get(id) != col:
			_colors[id] = col
			var mi = n.get_node_or_null("Mesh")
			if mi:
				mi.material_override.albedo_color = Color.from_string(col, Color.WHITE)
	var cam := get_viewport().get_camera_3d()
	if cam and cam.has_meta("follow"):
		var f = entities.get(cam.get_meta("follow"))
		if f != null and is_instance_valid(f):
			cam.position.x = f.global_position.x
			cam.position.y = f.global_position.y
	_channels_tick(delta)


# ------------------------------------------------------------------ channels (NLCL hub)
func add_channel(id: String, url: String, src: String, dst: String, fields: Array, interval_ms: int,
		src_local: bool, dst_local: bool) -> void:
	var ch := {"id": id, "url": url, "src": src, "dst": dst, "fields": fields,
		"interval": max(0.05, interval_ms / 1000.0), "src_local": src_local, "dst_local": dst_local,
		"t": 0.0, "seen": null, "req": null}
	if not (src_local and dst_local):
		var req := HTTPRequest.new()
		req.timeout = 2.0
		add_child(req)
		ch["req"] = req
		req.request_completed.connect(func(result, code, _headers, body): _on_http(ch, result, code, body))
	channels.append(ch)


func send(n, to: String, fields: Array) -> void:
	var sent := false
	for ch in channels:
		if ch["src"] != n.nlcl_id:
			continue
		if to != "" and to != ch["dst"] and to != ch["id"]:
			continue
		_emit(ch, fields if fields.size() > 0 else ch["fields"])
		sent = true
	# no channel declared, but the receiver lives in this game: deliver directly
	if not sent and to != "" and entities.has(to) and is_instance_valid(entities[to]):
		var payload := {}
		for f in fields:
			payload[f] = n.nlcl_get(f)
		deliver({"id": n.nlcl_id + "_to_" + to, "src": n.nlcl_id, "dst": to, "fields": fields,
			"dst_local": true, "src_local": true}, payload)


func _emit(ch: Dictionary, fields: Array) -> void:
	var e = entities.get(ch["src"])
	if e == null or not is_instance_valid(e):
		return
	var payload := {}
	for f in fields:
		payload[f] = e.nlcl_get(f)
	if ch["dst_local"]:
		deliver(ch, payload)
		return
	payload["channel"] = ch["id"]
	payload["from"] = ch["src"]
	ch["req"].request(ch["url"], ["Content-Type: application/json"], HTTPClient.METHOD_POST, JSON.stringify(payload))


func _channels_tick(delta: float) -> void:
	for ch in channels:
		ch["t"] += delta
		if ch["src_local"]:
			if ch["t"] >= ch["interval"]:
				ch["t"] = 0.0
				_emit(ch, ch["fields"])
		elif ch["dst_local"] and ch["t"] >= max(0.2, ch["interval"] / 2.0):
			ch["t"] = 0.0
			ch["req"].request(ch["url"])


func _on_http(ch: Dictionary, result: int, code: int, body: PackedByteArray) -> void:
	if result != HTTPRequest.RESULT_SUCCESS or code != 200 or ch["src_local"]:
		return
	var d = JSON.parse_string(body.get_string_from_utf8())
	if d is Dictionary and d.size() > 0 and d.get("_t") != ch["seen"]:
		ch["seen"] = d.get("_t")
		deliver(ch, d)


func deliver(ch: Dictionary, payload: Dictionary) -> void:
	## copy fields onto the destination entity, then fire message / input behaviours
	var any_bool := false
	var rising := false
	for k in payload:
		if k == "channel" or k == "from" or str(k).begins_with("_"):
			continue
		remote[ch["src"] + "." + k] = payload[k]
		if typeof(payload[k]) == TYPE_BOOL:
			any_bool = true
			var key: String = ch["src"] + "." + k
			if payload[k] and not _last_bool.get(key, false):
				rising = true
			_last_bool[key] = payload[k]
	var dst = entities.get(ch["dst"])
	if dst != null and is_instance_valid(dst):
		for k in payload:
			if k != "channel" and k != "from" and not str(k).begins_with("_"):
				dst.nlcl_set(k, payload[k])
	for id in entities.keys():
		var e = entities[id]
		if not is_instance_valid(e):
			continue
		e.nlcl_message(ch["src"], e == dst)
		if rising or not any_bool:
			e.nlcl_remote_input(ch["src"])
